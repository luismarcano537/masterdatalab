@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, JJMasterData.Web
@using masterdatalab.domain.Services

<!DOCTYPE html>
<html data-bs-theme="light" lang="@System.Globalization.CultureInfo.CurrentCulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <partial name="_MasterDataStylesheets" />
    @await RenderSectionAsync("Stylesheets", required: false)
    <partial name="_MasterDataScripts" />
</head>
<body>
    <div class="container-fluid">
        <nav class="navbar navbar-expand bg-light px-3 mb-3">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">MasterDataLab</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Pedidos" asp-action="Index">Pedidos</a>

                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Cadastros</a>
                    <ul class="dropdown-menu">
                        @foreach (var item in CadastroService.Elementos)
                        {
                            <li><a class="dropdown-item" href="/Cadastros/@item.Key">@item.Value</a></li>
                        }
                    </ul>
                </div>

                <a class="nav-link" href="/DataDictionary">Dicionário</a>
            </div>
        </nav>
        @RenderBody()
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>