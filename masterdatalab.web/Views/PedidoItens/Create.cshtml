@model masterdatalab.domain.Models.ViewModels.PedidosViewModel
@{ ViewData["Title"] = "Incluir item"; }

<div class="d-flex align-items-center gap-3 mt-3 mb-3">
    <a asp-controller="Pedidos" asp-action="Edit" asp-route-codPedido="@Model.CodPedido"
       class="btn btn-outline-secondary btn-sm">← Pedido nº @Model.CodPedido</a>
    <h3 class="mb-0">Incluir item</h3>
</div>

<form asp-action="Create" asp-route-codPedido="@Model.CodPedido" method="post">
    <div class="card">
        <div class="card-body">
            @Html.Raw(ViewBag.Content)

            @if (Model.ValidationSummaryHtml is not null)
            {
                @Html.Raw(Model.ValidationSummaryHtml)
            }
            @Html.Raw(Model.MensagemHtml)

            <button type="submit" class="btn btn-primary mt-2">Salvar</button>
            <a asp-controller="Pedidos" asp-action="Edit" asp-route-codPedido="@Model.CodPedido"
               class="btn btn-secondary mt-2">Cancelar</a>
        </div>
    </div>
</form>